    "schema": "scienceutopia.code-mechanism.v1",
    "label": "Research Commons Decision Engine",
    "source": "import json\nfrom collections import defaultdict\n\ndef step(context):\n    inputs = context['inputs']\n    state = context['state']\n    outputs = defaultdict(list)\n    decisions = {}\n    artifacts = {}\n\n    for delivered in inputs['review_batches']:\n        batch = delivered['payload']\n        batch_id = batch['batch_id']\n        papers = batch['papers']\n        reviews = batch['reviews']\n\n        for paper in papers:\n            paper_id = paper['id']\n            author_id = paper['author_id']\n            paper_data = paper\n\n            # Aggregate reviews\n            paper_reviews = reviews.get(paper_id, [])\n            total_score = sum(review['overall_score'] for review in paper_reviews)\n            final_score = total_score / len(paper_reviews) if paper_reviews else 0\n\n            # Decision logic\n            if final_score >= 8:\n                decision = 'accept'\n            elif final_score >= 5:\n                decision = 'reject'\n            else:\n                decision = 'reject'\n\n            # Decision record\n            decision_record = {\n                'batch_id': batch_id,\n                'paper_id': paper_id,\n                'decision': decision,\n                'paper': paper_data\n            }\n            outputs['decisions'].append({'payload': decision_record, 'actor_ids': [author_id], 'artifact_ids': [paper_id]})\n            decisions[paper_id] = decision_record\n\n        # Artifact: Paper scores\n        for paper in papers:\n            paper_id = paper['id']\n            paper_reviews = reviews.get(paper_id, [])\n            total_score = sum(review['overall_score'] for review in paper_reviews)\n            final_score = total_score / len(paper_reviews) if paper_reviews else 0\n\n            artifact_record = {\n                'batch_id': batch_id,\n                'paper_id': paper_id,\n                'final_score': final_score,\n                'num_reviews': len(paper_reviews)\n            }\n            outputs['paper_scores'].append({'payload': artifact_record, 'actor_ids': [author_id], 'artifact_ids': [paper_id]})\n            artifacts[paper_id] = artifact_record\n\n    state['decisions'] = decisions\n    state['artifacts'] = artifacts\n    return {'outputs': dict(outputs), 'state': state}",
