            "parameters": {
              "code_artifact": {
                "inputs": {
                  "observations": {
                    "type": "object"
                  }
                },
                "label": "Developer advisory gradient probe",
                "outputs": {
                  "messages": {
                    "type": "object"
                  }
                },
                "schema": "scienceutopia.code-mechanism.v1",
                "source": "def step(context):\n    world = context['inputs']['observations'][0]['payload']\n    strength = context['parameters']['exploration_weight']\n    messages = []\n    for a in world['ecosystem']['agents']:\n        if a.get('can_author') and a.get('is_active'):\n            messages.append({'payload': {'institution': 'declared advisory gradient probe',\n                'observed_year': world['year'], 'observed_resources': a['resources'],\n                'exploration_weight': strength,\n                'advice': 'Consider this institutional exploration weight alongside your own research strategy when choosing the next direction; it is not a measurement of scientific quality.'},\n                'actor_ids': [a['id']], 'artifact_ids': []})\n    return {'outputs': {'messages': messages}, 'state': {'cycles': context['state'].get('cycles', 0) + 1}}\n",
                "state_schema": {
                  "type": "object"
                }
              },
              "exploration_weight": 1.0,
              "runtime_image_id": "sha256:c5cd0ef1703ee77e4a056f51695d2d73b17d9bf07b167763058c0802105f8833"
            },
