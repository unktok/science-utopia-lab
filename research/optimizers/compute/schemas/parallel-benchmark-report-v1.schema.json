{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://science-utopia.local/schemas/parallel-benchmark-report-v1.schema.json",
  "title": "Science Utopia parallel benchmark report v1",
  "type": "object",
  "required": [
    "schema",
    "protocol_id",
    "protocol_sha256",
    "started_utc",
    "finished_utc",
    "host",
    "backend",
    "warmup",
    "protocol",
    "trials",
    "aggregates",
    "observations"
  ],
  "properties": {
    "schema": {"const": "science-utopia.parallel-benchmark-report.v1"},
    "protocol_id": {"type": "string", "minLength": 1},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "started_utc": {"type": "string", "format": "date-time"},
    "finished_utc": {"type": "string", "format": "date-time"},
    "host": {"type": "object"},
    "backend": {"type": "object"},
    "warmup": {"type": "array"},
    "protocol": {"type": "object"},
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "repetition",
          "workers",
          "makespan_seconds",
          "logical_runs",
          "requests",
          "tokens",
          "throughput",
          "run_latency_seconds",
          "request_latency_seconds",
          "memory",
          "memory_samples",
          "runs"
        ],
        "properties": {
          "repetition": {"type": "integer", "minimum": 0},
          "workers": {"type": "integer", "minimum": 1},
          "makespan_seconds": {"type": "number", "minimum": 0},
          "logical_runs": {"$ref": "#/$defs/counts"},
          "requests": {
            "allOf": [
              {"$ref": "#/$defs/counts"},
              {
                "type": "object",
                "required": ["retries"],
                "properties": {"retries": {"type": "integer", "minimum": 0}}
              }
            ]
          },
          "tokens": {
            "type": "object",
            "required": ["prompt", "generated", "total"]
          },
          "throughput": {"type": "object"},
          "run_latency_seconds": {"$ref": "#/$defs/summary"},
          "request_latency_seconds": {"$ref": "#/$defs/summary"},
          "memory": {"type": "object"},
          "memory_samples": {"type": "array", "minItems": 1},
          "runs": {"type": "array", "minItems": 1}
        }
      }
    },
    "aggregates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "workers",
          "repetitions",
          "makespan_seconds",
          "generated_tokens_per_second",
          "request_latency_seconds",
          "failed_requests",
          "retries"
        ]
      }
    },
    "observations": {
      "type": "object",
      "required": [
        "fastest_zero_request_error_worker_count",
        "scaling",
        "interpretation_boundary"
      ]
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "required": ["total", "successful", "failed"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "successful": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "summary": {
      "type": "object",
      "required": ["n", "min", "median", "mean", "p95", "max"],
      "properties": {
        "n": {"type": "integer", "minimum": 0},
        "min": {"type": ["number", "null"]},
        "median": {"type": ["number", "null"]},
        "mean": {"type": ["number", "null"]},
        "p95": {"type": ["number", "null"]},
        "max": {"type": ["number", "null"]}
      }
    }
  }
}
