{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://science-utopia.local/schemas/objective-compilation-v1.schema.json",
  "title": "ScienceUtopia Objective Compilation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "objective_spec", "metric_registry", "constitution_summary", "hard_constraints", "tradeoffs", "goodhart_audit", "measurement_evidence_policy", "compiled_phases", "warnings"],
  "properties": {
    "schema": {"const": "scienceutopia.objective-compilation.v1"},
    "status": {"enum": ["prospective-future-campaign", "synthetic-test-only"]},
    "objective_spec": {"$ref": "#/$defs/reference"},
    "metric_registry": {"$ref": "#/$defs/reference"},
    "constitution_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["governance", "stakeholder_ids", "construct_ids", "time_horizon", "distribution", "uncertainty"],
      "properties": {
        "governance": {"type": "object"},
        "stakeholder_ids": {"$ref": "#/$defs/strings"},
        "construct_ids": {"$ref": "#/$defs/strings"},
        "time_horizon": {"type": "object"},
        "distribution": {"type": "object"},
        "uncertainty": {"type": "object"}
      }
    },
    "hard_constraints": {"const": []},
    "tradeoffs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "goodhart_audit": {"type": "object"},
    "measurement_evidence_policy": {"type": "object"},
    "compiled_phases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/compiledPhase"}},
    "warnings": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "compiledPhase": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "loss_spec", "loss_spec_sha256", "component_receipts"],
      "properties": {
        "phase": {"type": "object"},
        "loss_spec": {"$ref": "#/$defs/lossSpec"},
        "loss_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "component_receipts": {"type": "array", "minItems": 2, "items": {"type": "object"}}
      }
    },
    "lossSpec": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "id", "version", "status", "direction", "optimization_seed_role", "per_run", "across_seeds", "interpretation", "prohibited_claims"],
      "properties": {
        "schema": {"const": "scienceutopia.loss-spec.v1"},
        "id": {"type": "string"},
        "version": {"type": "string"},
        "status": {"const": "research"},
        "direction": {"const": "minimize"},
        "optimization_seed_role": {"const": "optimization"},
        "per_run": {"type": "object"},
        "across_seeds": {"type": "object"},
        "interpretation": {"type": "string"},
        "prohibited_claims": {"$ref": "#/$defs/strings"}
      }
    }
  }
}
