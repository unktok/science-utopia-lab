{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://science-utopia.local/schemas/objective-spec-v1.schema.json",
  "title": "ScienceUtopia ObjectiveSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "status", "scope", "governance", "stakeholders", "constructs", "time_horizon", "distribution", "uncertainty", "phases", "components", "tradeoffs", "hard_constraints", "goodhart_audit", "measurement_evidence_policy", "prohibited_claims"],
  "properties": {
    "schema": {"const": "scienceutopia.objective-spec.v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "prospective-future-campaign"},
    "scope": {"type": "string", "minLength": 1},
    "governance": {
      "type": "object", "additionalProperties": false,
      "required": ["active_campaign_effect", "universal_objective_claim", "decision_authority", "mandate", "amendment_process", "review_date", "public_reason"],
      "properties": {
        "active_campaign_effect": {"const": "none"},
        "universal_objective_claim": {"const": "none"},
        "decision_authority": {"type": "string", "minLength": 1},
        "mandate": {"type": "string", "minLength": 1},
        "amendment_process": {"type": "string", "minLength": 1},
        "review_date": {"type": "string", "format": "date"},
        "public_reason": {"type": "string", "minLength": 1}
      }
    },
    "stakeholders": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/stakeholder"}},
    "constructs": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/construct"}},
    "time_horizon": {"$ref": "#/$defs/timeHorizon"},
    "distribution": {"$ref": "#/$defs/distribution"},
    "uncertainty": {"$ref": "#/$defs/uncertainty"},
    "phases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/phase"}},
    "components": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/component"}},
    "tradeoffs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tradeoff"}},
    "hard_constraints": {"const": []},
    "goodhart_audit": {"$ref": "#/$defs/goodhart"},
    "measurement_evidence_policy": {"$ref": "#/$defs/evidencePolicy"},
    "prohibited_claims": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "stakeholder": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "standing", "interests", "possible_burdens", "voice_and_authority"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "role": {"enum": ["beneficiary", "burden-bearer", "worker", "funder", "affected-non-user", "future-interest-proxy", "scientific-community"]},
        "standing": {"type": "string", "minLength": 1},
        "interests": {"$ref": "#/$defs/strings"},
        "possible_burdens": {"$ref": "#/$defs/strings"},
        "voice_and_authority": {"type": "string", "minLength": 1}
      }
    },
    "construct": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "definition", "normative_reason", "not_equivalent_to", "stakeholder_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "definition": {"type": "string", "minLength": 1},
        "normative_reason": {"type": "string", "minLength": 1},
        "not_equivalent_to": {"$ref": "#/$defs/strings"},
        "stakeholder_refs": {"$ref": "#/$defs/strings"}
      }
    },
    "timeHorizon": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_horizon", "outcome_windows", "discounting", "lag_policy", "terminal_value_policy"],
      "properties": {
        "decision_horizon": {"type": "string", "minLength": 1},
        "outcome_windows": {"$ref": "#/$defs/strings"},
        "discounting": {"type": "string", "minLength": 1},
        "lag_policy": {"type": "string", "minLength": 1},
        "terminal_value_policy": {"type": "string", "minLength": 1}
      }
    },
    "distribution": {
      "type": "object", "additionalProperties": false,
      "required": ["unit", "groups", "aggregation", "incidence_reporting", "unknown_group_policy"],
      "properties": {
        "unit": {"type": "string", "minLength": 1},
        "groups": {"$ref": "#/$defs/strings"},
        "aggregation": {"type": "string", "minLength": 1},
        "incidence_reporting": {"type": "string", "minLength": 1},
        "unknown_group_policy": {"type": "string", "minLength": 1}
      }
    },
    "uncertainty": {
      "type": "object", "additionalProperties": false,
      "required": ["aleatory", "epistemic", "risk_aggregation", "dispersion_weight", "minimum_valid_runs", "missingness_policy"],
      "properties": {
        "aleatory": {"type": "string", "minLength": 1},
        "epistemic": {"type": "string", "minLength": 1},
        "risk_aggregation": {"const": "mean_plus_population_sd"},
        "dispersion_weight": {"type": "number", "minimum": 0},
        "minimum_valid_runs": {"type": "integer", "minimum": 2},
        "missingness_policy": {"const": "reject-unmeasured-run-no-imputation-penalty"}
      }
    },
    "phase": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "start_step", "end_step", "reason"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "start_step": {"type": "integer", "minimum": 0},
        "end_step": {"type": ["integer", "null"], "minimum": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "construct_ref", "metric_card_ref", "weights", "stakeholder_refs", "distribution_interpretation", "time_interpretation", "rationale"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "construct_ref": {"type": "string", "minLength": 1},
        "metric_card_ref": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "version", "sha256"],
          "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        },
        "weights": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["phase_ref", "value"], "properties": {"phase_ref": {"type": "string"}, "value": {"type": "number", "minimum": 0}}}},
        "stakeholder_refs": {"$ref": "#/$defs/strings"},
        "distribution_interpretation": {"type": "string", "minLength": 1},
        "time_interpretation": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "tradeoff": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "component_refs", "reason", "treatment", "not_a_veto"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "component_refs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
        "reason": {"type": "string", "minLength": 1},
        "treatment": {"const": "explicit-weighted-tradeoff"},
        "not_a_veto": {"const": true}
      }
    },
    "goodhart": {
      "type": "object", "additionalProperties": false,
      "required": ["known_failure_modes", "adversarial_evidence_refs", "shadow_monitors", "review_triggers", "expiry_policy"],
      "properties": {
        "known_failure_modes": {"$ref": "#/$defs/strings"},
        "adversarial_evidence_refs": {"$ref": "#/$defs/strings"},
        "shadow_monitors": {"$ref": "#/$defs/strings"},
        "review_triggers": {"$ref": "#/$defs/strings"},
        "expiry_policy": {"type": "string", "minLength": 1}
      }
    },
    "evidencePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_status", "required_scopes", "independent_review", "promotion_boundary"],
      "properties": {
        "minimum_status": {"const": "validated-for-optimization"},
        "required_scopes": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["construct-validity", "adversarial-validity", "measurement-reliability", "distributional-validity", "temporal-validity"]}},
        "independent_review": {"const": true},
        "promotion_boundary": {"const": "future-campaign-only"}
      }
    }
  }
}
