{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://science-utopia.local/schemas/differentiable-system-design-report-v0.schema.json",
  "title": "ScienceUtopia Differentiable System Design synthetic report v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "design", "objective_binding", "gradient_trace", "optimized_raw", "relaxed_final", "outer_validation", "audit"],
  "properties": {
    "schema": {"const": "scienceutopia.differentiable-system-design-report.v0"},
    "status": {"const": "synthetic-proof-only"},
    "design": {"$ref": "#/$defs/hashRef"},
    "objective_binding": {"$ref": "#/$defs/objectiveBinding"},
    "gradient_trace": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "surrogate_mean", "surrogate_uncertainty", "raw_gradient_norm", "raw", "features"],
        "properties": {
          "step": {"type": "integer", "minimum": 0},
          "surrogate_mean": {"type": "number"},
          "surrogate_uncertainty": {"type": "number", "minimum": 0},
          "raw_gradient_norm": {"type": "number", "minimum": 0},
          "raw": {"$ref": "#/$defs/numericMap"},
          "features": {"$ref": "#/$defs/numericMap"}
        }
      }
    },
    "optimized_raw": {"$ref": "#/$defs/numericMap"},
    "relaxed_final": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surrogate_mean", "surrogate_uncertainty"],
      "properties": {
        "surrogate_mean": {"type": "number"},
        "surrogate_uncertainty": {"type": "number", "minimum": 0}
      }
    },
    "outer_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "records", "projection_instability", "relaxation_projection_gap", "goodhart_flags"],
      "properties": {
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evaluator", "data_role", "scenarios", "thresholds"],
          "properties": {
            "evaluator": {"const": "synthetic-nondifferentiable-black-box"},
            "data_role": {"const": "synthetic-development-validation-not-confirmatory"},
            "scenarios": {"$ref": "#/$defs/strings"},
            "thresholds": {
              "type": "object",
              "additionalProperties": false,
              "required": ["maximum_absolute_gap", "maximum_relaxation_projection_gap", "maximum_uncertainty", "projection_epsilon"],
              "properties": {
                "maximum_absolute_gap": {"type": "number", "minimum": 0},
                "maximum_relaxation_projection_gap": {"type": "number", "minimum": 0},
                "maximum_uncertainty": {"type": "number", "minimum": 0},
                "projection_epsilon": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          }
        },
        "records": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initial", "optimized"],
          "properties": {
            "initial": {"$ref": "#/$defs/outerRecord"},
            "optimized": {"$ref": "#/$defs/outerRecord"}
          }
        },
        "projection_instability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["epsilon", "sensitive_raw_ids", "sensitive_fraction"],
          "properties": {
            "epsilon": {"type": "number", "exclusiveMinimum": 0},
            "sensitive_raw_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "sensitive_fraction": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "relaxation_projection_gap": {"type": "number", "minimum": 0},
        "goodhart_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["potential_goodhart_flags", "observed_goodhart_flags", "prohibited_claims"],
      "properties": {
        "potential_goodhart_flags": {"$ref": "#/$defs/strings"},
        "observed_goodhart_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "prohibited_claims": {"$ref": "#/$defs/strings"}
      }
    }
  },
  "$defs": {
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "hashRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "objectiveBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective_spec", "compilation_sha256", "loss_spec", "phase", "source_paths", "role"],
      "properties": {
        "objective_spec": {"$ref": "#/$defs/hashRef"},
        "compilation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "loss_spec": {"$ref": "#/$defs/hashRef"},
        "phase": {"type": "string", "minLength": 1},
        "source_paths": {"$ref": "#/$defs/strings"},
        "role": {"const": "synthetic-future-loss-only"}
      }
    },
    "numericMap": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}},
    "decision": {
      "type": "object",
      "required": ["kind", "id", "probability", "selected"],
      "properties": {
        "kind": {"enum": ["mechanism-presence", "mechanism-projection", "edge-projection"]},
        "id": {"type": "string"},
        "probability": {"type": "number", "minimum": 0, "maximum": 1},
        "selected": {"type": "boolean"}
      }
    },
    "blackBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "loss", "scenario_losses", "system_fingerprint", "loss_spec_sha256"],
      "properties": {
        "status": {"const": "complete"},
        "loss": {"type": "number"},
        "scenario_losses": {"$ref": "#/$defs/numericMap"},
        "system_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "loss_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "outerRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_spec", "system_fingerprint", "projection_decisions", "projected_features", "surrogate_mean", "surrogate_uncertainty", "black_box", "absolute_surrogate_gap"],
      "properties": {
        "system_spec": {"type": "object"},
        "system_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "projection_decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision"}},
        "projected_features": {"$ref": "#/$defs/numericMap"},
        "surrogate_mean": {"type": "number"},
        "surrogate_uncertainty": {"type": "number", "minimum": 0},
        "black_box": {"$ref": "#/$defs/blackBox"},
        "absolute_surrogate_gap": {"type": "number", "minimum": 0}
      }
    }
  }
}
