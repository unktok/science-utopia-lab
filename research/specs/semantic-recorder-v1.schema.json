{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://science-utopia.local/schemas/semantic-recorder-v1.schema.json",
  "title": "Science Utopia prospective semantic recorder/checkpoint v1",
  "oneOf": [
    {"$ref": "#/$defs/config"},
    {"$ref": "#/$defs/header"},
    {"$ref": "#/$defs/entry"},
    {"$ref": "#/$defs/checkpoint"}
  ],
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "missing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "detail"],
      "properties": {
        "status": {"const": "missing"},
        "reason": {
          "enum": [
            "not_observed",
            "measurement_failed",
            "redacted",
            "not_applicable",
            "unknown"
          ]
        },
        "detail": {"$ref": "#/$defs/nonempty"}
      }
    },
    "ground_truth": {
      "oneOf": [
        {"$ref": "#/$defs/missing"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "schema", "universe_id", "targets"],
          "properties": {
            "status": {"const": "observed"},
            "schema": {"const": "scienceutopia.semantic-ground-truth.v1"},
            "universe_id": {"$ref": "#/$defs/nonempty"},
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["truth_target_id", "truth", "difficulty", "importance"],
                "properties": {
                  "truth_target_id": {"$ref": "#/$defs/nonempty"},
                  "truth": {"type": "boolean"},
                  "difficulty": {"enum": ["easy", "medium", "hard"]},
                  "importance": {"type": "number", "exclusiveMinimum": 0}
                }
              }
            }
          }
        }
      ]
    },
    "disabled_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "enabled"],
      "properties": {
        "schema": {"const": "scienceutopia.semantic-recorder-config.v1"},
        "enabled": {"const": false}
      }
    },
    "enabled_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "enabled",
        "recorder_id",
        "bundle_id",
        "classification",
        "instrumentation_use",
        "run_id",
        "producer",
        "system_fingerprint",
        "model_fingerprint",
        "ground_truth"
      ],
      "properties": {
        "schema": {"const": "scienceutopia.semantic-recorder-config.v1"},
        "enabled": {"const": true},
        "recorder_id": {"$ref": "#/$defs/nonempty"},
        "bundle_id": {"$ref": "#/$defs/nonempty"},
        "classification": {
          "enum": [
            "synthetic_ground_truth",
            "synthetic_gaming_counterexample",
            "experimental_shadow"
          ]
        },
        "instrumentation_use": {"const": "report_only"},
        "run_id": {"$ref": "#/$defs/nonempty"},
        "producer": {"$ref": "#/$defs/nonempty"},
        "system_fingerprint": {"$ref": "#/$defs/sha256"},
        "model_fingerprint": {"$ref": "#/$defs/sha256"},
        "ground_truth": {"$ref": "#/$defs/ground_truth"}
      }
    },
    "config": {
      "oneOf": [
        {"$ref": "#/$defs/disabled_config"},
        {"$ref": "#/$defs/enabled_config"}
      ]
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "record_type",
        "recorder_id",
        "bundle_id",
        "classification",
        "instrumentation_use",
        "optimization_input",
        "run_id",
        "producer",
        "system_fingerprint",
        "model_fingerprint",
        "ground_truth",
        "integrity_algorithm",
        "header_sha256"
      ],
      "properties": {
        "schema": {"const": "scienceutopia.semantic-recorder-header.v1"},
        "record_type": {"const": "header"},
        "recorder_id": {"$ref": "#/$defs/nonempty"},
        "bundle_id": {"$ref": "#/$defs/nonempty"},
        "classification": {
          "enum": [
            "synthetic_ground_truth",
            "synthetic_gaming_counterexample",
            "experimental_shadow"
          ]
        },
        "instrumentation_use": {"const": "report_only"},
        "optimization_input": {"const": false},
        "run_id": {"$ref": "#/$defs/nonempty"},
        "producer": {"$ref": "#/$defs/nonempty"},
        "system_fingerprint": {"$ref": "#/$defs/sha256"},
        "model_fingerprint": {"$ref": "#/$defs/sha256"},
        "ground_truth": {"$ref": "#/$defs/ground_truth"},
        "integrity_algorithm": {"const": "sha256-canonical-json-chain-v1"},
        "header_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "semantic_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "event_id",
        "sequence",
        "step",
        "event_type",
        "actor_id",
        "institution_id",
        "provenance",
        "payload"
      ],
      "properties": {
        "schema": {
          "enum": [
            "scienceutopia.semantic-claim-event.v1",
            "scienceutopia.semantic-evidence-event.v1",
            "scienceutopia.semantic-verification-event.v1",
            "scienceutopia.semantic-replication-event.v1",
            "scienceutopia.semantic-correction-event.v1"
          ]
        },
        "event_id": {"$ref": "#/$defs/nonempty"},
        "sequence": {"type": "integer", "minimum": 0},
        "step": {"type": "integer", "minimum": 0},
        "event_type": {
          "enum": [
            "claim.created",
            "claim.revised",
            "claim.withdrawn",
            "evidence.attached",
            "evidence.invalidated",
            "verification.completed",
            "replication.attempted",
            "replication.resolved",
            "correction.issued",
            "correction.propagated"
          ]
        },
        "actor_id": {"$ref": "#/$defs/nonempty"},
        "institution_id": {"$ref": "#/$defs/nonempty"},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["run_id", "producer", "source_event_ids"],
          "properties": {
            "run_id": {"$ref": "#/$defs/nonempty"},
            "producer": {"$ref": "#/$defs/nonempty"},
            "source_event_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/nonempty"}
            }
          }
        },
        "payload": {"type": "object"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "record_type",
        "entry_index",
        "run_id",
        "system_fingerprint",
        "model_fingerprint",
        "previous_entry_sha256",
        "event",
        "entry_sha256"
      ],
      "properties": {
        "schema": {"const": "scienceutopia.semantic-recorder-entry.v1"},
        "record_type": {"const": "event"},
        "entry_index": {"type": "integer", "minimum": 0},
        "run_id": {"$ref": "#/$defs/nonempty"},
        "system_fingerprint": {"$ref": "#/$defs/sha256"},
        "model_fingerprint": {"$ref": "#/$defs/sha256"},
        "previous_entry_sha256": {"$ref": "#/$defs/sha256"},
        "event": {"$ref": "#/$defs/semantic_event"},
        "entry_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "recorder_id",
        "run_id",
        "header_sha256",
        "entry_count",
        "tail_entry_sha256",
        "last_event_id",
        "last_sequence",
        "stream_size_bytes",
        "stream_sha256",
        "checkpoint_sha256"
      ],
      "properties": {
        "schema": {"const": "scienceutopia.semantic-recorder-checkpoint.v1"},
        "recorder_id": {"$ref": "#/$defs/nonempty"},
        "run_id": {"$ref": "#/$defs/nonempty"},
        "header_sha256": {"$ref": "#/$defs/sha256"},
        "entry_count": {"type": "integer", "minimum": 0},
        "tail_entry_sha256": {"$ref": "#/$defs/sha256"},
        "last_event_id": {"type": ["string", "null"], "minLength": 1},
        "last_sequence": {"type": ["integer", "null"], "minimum": 0},
        "stream_size_bytes": {"type": "integer", "minimum": 1},
        "stream_sha256": {"$ref": "#/$defs/sha256"},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
