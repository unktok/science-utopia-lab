      ],
      "parameters": {
        "code_artifact": {
          "inputs": {
            "after": {
              "type": "object"
            },
            "observations": {
              "type": "object"
            }
          },
          "label": "MaximizeAcceptedDecisionsAlgorithm",
          "outputs": {
            "decisions": {
              "type": "object"
            },
            "next": {
              "type": "object"
            },
            "world": {
              "type": "object"
            }
          },
          "schema": "scienceutopia.code-mechanism.v1",
          "source": "def step(context):\n    world = context['inputs']['observations'][0]['payload']\n    decisions = []\n    for conf in world['conferences']['conferences']:\n        scored = []\n        for paper in conf['submitted_papers']:\n            reviews = conf['reviews'].get(paper['id'], [])\n            if not reviews:\n                raise ValueError('actual submitted paper has no reviews')\n            score = sum(r['overall_score'] for r in reviews) / len(reviews)\n            scored.append((paper['id'], score))\n        scored.sort(key=lambda pair: pair[1], reverse=True)\n        # Set a threshold score for acceptance\n        threshold_score = 2.5\n        for paper_id, score in scored:\n            if score >= threshold_score:\n                decisions.append({'payload': {'paper_id': paper_id, 'conference_id': conf['conference_id'],\n                    'final_score': score, 'decision': 'accept'}})\n            else:\n                decisions.append({'payload': {'paper_id': paper_id, 'conference_id': conf['conference_id'],\n                    'final_score': score, 'decision': 'reject'}})\n    if not decisions:\n        decisions = [{'payload': {'empty_cycle': True}}]\n    return {'outputs': {'next': [{'payload': {'year': context['period']}}],\n        'world': [{'payload': world}], 'decisions': decisions},\n        'state': {'cycles': context['state'].get('cycles', 0) + 1}}",
          "state_schema": {
            "type": "object"
          }
        },
        "runtime_image_id": "sha256:c5cd0ef1703ee77e4a056f51695d2d73b17d9bf07b167763058c0802105f8833"
      },
